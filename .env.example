# ==========================================
# Conversational Data Analyst Environment Template
# Copy this file to .env and fill in your actual values.
# NEVER commit actual secrets or API keys to Git!
# ==========================================

# ------------ LLM Configurations ------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=1024

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=1024

# ------------ Database Connections ------------
# Business/target database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DATABASE_SCHEMA=public
SCHEMA_CACHE_TTL_SECONDS=300

# App control-plane database (users, chat sessions, logs)
APP_DATABASE_URL=postgresql://user:password@localhost:5432/app_control_plane

# ------------ Supabase Credentials ------------
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key
SUPABASE_ENABLED=true

# ------------ Application & Guardrails ------------
APP_ENV=development
APP_DEBUG=true
APP_NAME="AI Data Analyst"
LOG_LEVEL=INFO

ENABLE_SQL_VALIDATION=true
MAX_QUERY_TIMEOUT=30
ENABLE_CLARIFICATION=true
ENABLE_MONITORING=true

# ------------ Email & SMTP (OTP / Password Reset) ------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
FRONTEND_URL=http://localhost:5173

# ------------ Frontend API URL ------------
VITE_API_BASE_URL=http://localhost:8000
